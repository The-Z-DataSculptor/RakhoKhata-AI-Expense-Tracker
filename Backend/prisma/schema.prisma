/**
 * ==========================================================================
 * === SECTION 1: ENGINE & DATASOURCE CONFIGURATION (PRISMA 7 COMPLIANT) ===
 * ==========================================================================
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * === SECTION 1 END ===
 */

/**
 * ==========================================================================
 * === SECTION 2: DATABASE ENUMS ===
 * ==========================================================================
 */

enum TransactionType {
  INCOME
  EXPENSE
}

enum UITheme {
  LIGHT
  DARK
  SYSTEM
}

enum TokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  TWO_FACTOR
  MAGIC_LINK
  VAULT_PIN_RESET
}

/**
 * === SECTION 2 END ===
 */

/**
 * ==========================================================================
 * === SECTION 3: USER IDENTITY & AUTHENTICATION ===
 * ==========================================================================
 */

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  avatarUrl    String?
  vaultPin     String?
  uiTheme      UITheme  @default(DARK)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  country       String?
  currency      String?
  languages     String[]
  occupation    String?
  financialGoal String?
  aiPersona     String?

  isOnboardingCompleted Boolean @default(false)

  isEmailVerified     Boolean   @default(false)
  emailVerifiedAt     DateTime?
  emailDeliveryStatus String    @default("DELIVERED")

  weeklyDigestEnabled  Boolean @default(true)
  monthlyReportEnabled Boolean @default(true)

  workspaces    Workspace[]
  notifications Notification[]
  accounts      Account[]

  @@map("users")
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/**
 * === SECTION 3 END ===
 */

/**
 * ==========================================================================
 * === SECTION 4: WORKSPACE MULTI-TENANCY CORE ===
 * ==========================================================================
 */

model Workspace {
  id        String   @id @default(uuid())
  name      String
  currency  String   @default("PKR")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  investments  Investment[]

  @@unique([userId, name])
  @@index([userId, id])
  @@map("workspaces")
}

/**
 * === SECTION 4 END ===
 */

/**
 * ==========================================================================
 * === SECTION 5: CATEGORIES & TRANSACTION LEDGER ===
 * ==========================================================================
 */

model Category {
  id           String          @id @default(uuid())
  name         String
  type         TransactionType
  color        String
  isFixed      Boolean         @default(false)
  isRecurring  Boolean         @default(false)
  frequency    String?
  dueDay       Int?
  reminderDays Int?
  workspaceId  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([workspaceId, name, type])
  @@index([workspaceId])
  @@map("categories")
}

model Transaction {
  id String @id @default(uuid())

  originalAmount   Decimal @db.Decimal(12, 2)
  originalCurrency String  @default("USD")
  baseAmountUSD    Decimal @db.Decimal(12, 2)

  type        TransactionType
  description String
  date        DateTime
  workspaceId String
  categoryId  String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, date])
  @@index([workspaceId, deletedAt])
  @@index([categoryId])
  @@map("transactions")
}

/**
 * === SECTION 5 END ===
 */

/**
 * ==========================================================================
 * === SECTION 6: BUDGETS & INVESTMENTS ===
 * ==========================================================================
 */

model Budget {
  id String @id @default(uuid())

  originalAmount   Decimal @db.Decimal(12, 2)
  originalCurrency String  @default("USD")
  baseAmountUSD    Decimal @db.Decimal(12, 2)

  startDate   DateTime
  endDate     DateTime
  categoryId  String
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, categoryId, startDate, endDate])
  @@index([workspaceId])
  @@index([categoryId])
  @@map("budgets")
}

model Investment {
  id              String  @id @default(uuid())
  assetSymbol     String
  categoryClass   String
  isCustomProfile Boolean @default(false)

  originalAmount   Decimal @db.Decimal(12, 2)
  originalCurrency String  @default("USD")
  baseAmountUSD    Decimal @db.Decimal(12, 2)

  quantity     Decimal  @db.Decimal(16, 8)
  strategyNote String
  workspaceId  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("investments")
}

/**
 * === SECTION 6 END ===
 */

/**
 * ==========================================================================
 * === SECTION 7: NOTIFICATIONS & VERIFICATION TOKENS ===
 * ==========================================================================
 */

model Notification {
  id     String @id @default(uuid())
  userId String

  title   String
  message String

  sourceType String
  sourceId   String?

  isRead    Boolean   @default(false)
  readAt    DateTime?
  emailSent Boolean   @default(false)

  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model VerificationToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  type       TokenType
  identifier String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification_tokens")
}
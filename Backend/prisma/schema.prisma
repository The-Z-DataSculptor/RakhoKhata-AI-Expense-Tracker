// prisma/schema.prisma

/**
 * ==========================================================================
 * === SECTION 1: GENERATOR & DATA SOURCE CONFIGURATION LAYOUT ===
 * ==========================================================================
 */
generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql" // Removed direct 'url' property for Prisma 7 compliance
}

/**
 * ==========================================================================
 * === SECTION 2: USER ACCOUNT CORE IDENTITY SCHEMA ===
 * ==========================================================================
 */
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String? // IMPROVED: Made optional (?) to fully support passwordless Google OAuth signups
  avatarUrl    String? // ADDED: Captures dynamic Google/Social profile picture streams directly
  vaultPin     String?
  uiTheme      String   @default("DARK")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // DYNAMIC ONBOARDING AND GLOBAL AI PERSONALIZATION FIELDS
  country       String?
  currency      String?
  languages     String[]
  occupation    String?
  financialGoal String?
  aiPersona     String?

  // 🚀 WELCOME GATE SECURITY TRACKER
  // Defaults to false so new users are directed to the setup form before accessing the app dashboard
  isOnboardingCompleted Boolean @default(false)

  // FUTURE-PROOF MAILING EXTENSIONS (Email Verification & Security States)
  isEmailVerified     Boolean   @default(false)
  emailVerifiedAt     DateTime?
  emailDeliveryStatus String    @default("DELIVERED") // Handles bounce protection flags

  // FUTURISTIC NOTIFICATION PREFERENCE OPT-IN TOGGLES (Cron Engine Anchors)
  weeklyDigestEnabled  Boolean @default(true)
  monthlyReportEnabled Boolean @default(true)

  // Relational Connections
  workspaces    Workspace[]
  notifications Notification[]
  accounts      Account[] // Connects multiple safe validation strategy tracks

  @@map("users")
}

/**
 * ==========================================================================
 * === SECTION 2B: EXTERNAL SOCIAL AUTHENTICATION IDENTITY STACK ===
 * ==========================================================================
 */
model Account {
  id                String   @id @default(uuid())
  userId            String
  provider          String // Always sets explicitly to "GOOGLE" for this pipeline path
  providerAccountId String // The unique identity identification string code from Google servers
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId]) // 🛡️ SECURITY SHIELD: Blocks account-linking hijacking tricks
  @@map("accounts")
}

/**
 * ==========================================================================
 * === SECTION 3: WORKSPACE MULTI-TENANCY ANCHOR CORE ===
 * ==========================================================================
 */
model Workspace {
  id           String        @id @default(uuid())
  name         String
  currency     String        @default("PKR")
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  investments  Investment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("workspaces")
}

/**
 * ==========================================================================
 * === SECTION 4: DYNAMIC TRANSACTION CATEGORIES SCHEMA ===
 * ==========================================================================
 */
model Category {
  id           String        @id @default(uuid())
  name         String
  type         String
  color        String
  isFixed      Boolean       @default(false)
  isRecurring  Boolean       @default(false)
  frequency    String?
  dueDay       Int?
  reminderDays Int?
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("categories")
}

/**
 * ==========================================================================
 * === SECTION 5: HISTORICAL TRANSACTION LEDGER SCHEMA ===
 * ==========================================================================
 */
model Transaction {
  id String @id @default(uuid())

  // Permanent original values – never recalculated
  originalAmount   Decimal @db.Decimal(12, 2)
  originalCurrency String  @default("USD")
  baseAmountUSD    Decimal @db.Decimal(12, 2) // computed once at creation

  type        String
  description String
  date        DateTime
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("transactions")
}

/**
 * ==========================================================================
 * === SECTION 6: BUDGETING LIMIT & CAP MECHANICS ===
 * ==========================================================================
 */
model Budget {
  id String @id @default(uuid())

  // Original amount set by the user
  originalAmount   Decimal @db.Decimal(12, 2)
  originalCurrency String  @default("USD")
  baseAmountUSD    Decimal @db.Decimal(12, 2) // computed once at creation

  startDate   DateTime
  endDate     DateTime
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("budgets")
}

/**
 * ==========================================================================
 * === SECTION 7: SECURE INVESTMENT VAULT ASSET ENGINE ===
 * ==========================================================================
 */
model Investment {
  id              String  @id @default(uuid())
  assetSymbol     String
  categoryClass   String
  isCustomProfile Boolean @default(false)

  // Original amount in workspace currency – immutable
  originalAmount   Decimal @db.Decimal(12, 2)
  originalCurrency String  @default("USD")
  baseAmountUSD    Decimal @db.Decimal(12, 2)

  quantity     Decimal   @db.Decimal(16, 8)
  strategyNote String
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("investments")
}

/**
 * ==========================================================================
 * === SECTION 8: ENTERPRISE NOTIFICATION ENGINE ===
 * ==========================================================================
 */
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String

  sourceType String
  sourceId   String?

  isRead    Boolean   @default(false)
  readAt    DateTime?
  emailSent Boolean   @default(false)

  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("notifications")
}

/**
 * ==========================================================================
 * === SECTION 9: GENERAL PURPOSE VERIFICATION TOKENS (POLYMORPHIC ARCH) ===
 * ==========================================================================
 */
model VerificationToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique // Secure SHA-256 hash representation of the secret token/PIN string
  type       String // "PASSWORD_RESET" | "EMAIL_VERIFICATION" | "TWO_FACTOR" | "MAGIC_LINK"
  identifier String // Targets the specific identity record context (e.g., recipient email address)
  expiresAt  DateTime // Enforces token invalidation parameters
  createdAt  DateTime @default(now())

  @@index([tokenHash])
  @@map("verification_tokens")
}

// Backend/prisma/schema.prisma

/**
 * ==========================================================================
 * === SECTION 1: ENGINE & DATASOURCE CONFIGURATION (PRISMA 7 COMPLIANT) ===
 * ==========================================================================
 */

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  // Note: Connection URLs for Prisma 7 are managed entirely in `prisma.config.ts`
}

/**
 * === SECTION 1 END ===
 */

/**
 * ==========================================================================
 * === SECTION 2: DATABASE ENUMS (STRICT TYPE SAFETY) ===
 * ==========================================================================
 */

enum TransactionType {
  INCOME
  EXPENSE
}

enum UITheme {
  LIGHT
  DARK
  SYSTEM
}

enum TokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  TWO_FACTOR
  MAGIC_LINK
}

/**
 * === SECTION 2 END ===
 */

/**
 * ==========================================================================
 * === SECTION 3: USER IDENTITY & AUTHENTICATION ===
 * ==========================================================================
 */

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String? // Nullable for passwordless Google OAuth signups
  avatarUrl    String? // Stores dynamic social avatar image URLs
  vaultPin     String?
  uiTheme      UITheme  @default(DARK)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Dynamic Onboarding & Global AI Preferences
  country       String?
  currency      String?
  languages     String[]
  occupation    String?
  financialGoal String?
  aiPersona     String?

  // Onboarding Setup Tracker
  isOnboardingCompleted Boolean @default(false)

  // Security & Email Verification States
  isEmailVerified     Boolean   @default(false)
  emailVerifiedAt     DateTime?
  emailDeliveryStatus String    @default("DELIVERED")

  // Automated Digest Toggles
  weeklyDigestEnabled  Boolean @default(true)
  monthlyReportEnabled Boolean @default(true)

  // Relational Connections
  workspaces    Workspace[]
  notifications Notification[]
  accounts      Account[]

  @@map("users")
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  provider          String // e.g., "GOOGLE"
  providerAccountId String // Unique provider ID from Google
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // WHY THIS FIX WAS MADE: Composite index accelerates authorization lookups when checking
  // if an account provider maps to a specific user during OAuth authentication.
  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/**
 * === SECTION 3 END ===
 */

/**
 * ==========================================================================
 * === SECTION 4: WORKSPACE MULTI-TENANCY CORE ===
 * ==========================================================================
 */

model Workspace {
  id        String   @id @default(uuid())
  name      String
  currency  String   @default("PKR")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  investments  Investment[]

  // WHY THIS FIX WAS MADE: Composite index on userId and workspace id allows ultra-fast
  // BOLA/IDOR ownership checks during API requests before executing mutations.
  @@index([userId, id])
  @@map("workspaces")
}

/**
 * === SECTION 4 END ===
 */

/**
 * ==========================================================================
 * === SECTION 5: CATEGORIES & TRANSACTION LEDGER ===
 * ==========================================================================
 */

model Category {
  id           String          @id @default(uuid())
  name         String
  type         TransactionType // ENUM: Strict type constraint
  color        String
  isFixed      Boolean         @default(false)
  isRecurring  Boolean         @default(false)
  frequency    String?
  dueDay       Int?
  reminderDays Int?
  workspaceId  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relationships
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  // WHY THIS FIX WAS MADE: Prevents creation of duplicate categories with the exact same name
  // and transaction type within the same workspace, maintaining ledger data integrity.
  @@unique([workspaceId, name, type])
  @@index([workspaceId])
  @@map("categories")
}

model Transaction {
  id String @id @default(uuid())

  // Permanent original currency values (Decimal avoids floating point math bugs)
  originalAmount   Decimal @db.Decimal(12, 2)
  originalCurrency String  @default("USD")
  baseAmountUSD    Decimal @db.Decimal(12, 2)

  type        TransactionType // ENUM: Strict type constraint
  description String
  date        DateTime
  workspaceId String
  categoryId  String? // Optional so deleting a category won't wipe transaction history

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Indexes to prevent full table scans in PostgreSQL
  @@index([workspaceId])
  @@index([workspaceId, date]) // High performance dashboard date filtering
  @@index([categoryId]) // Category filtering
  @@map("transactions")
}

/**
 * === SECTION 5 END ===
 */

/**
 * ==========================================================================
 * === SECTION 6: BUDGETS & INVESTMENTS ===
 * ==========================================================================
 */

model Budget {
  id String @id @default(uuid())

  originalAmount   Decimal @db.Decimal(12, 2)
  originalCurrency String  @default("USD")
  baseAmountUSD    Decimal @db.Decimal(12, 2)

  startDate   DateTime
  endDate     DateTime
  categoryId  String
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // WHY THIS FIX WAS MADE: Enforces a unique constraint per category and date range inside a workspace
  // to prevent overlapping budgets from causing double-counting errors in summary metrics.
  @@unique([workspaceId, categoryId, startDate, endDate])
  @@index([workspaceId])
  @@index([categoryId])
  @@map("budgets")
}

model Investment {
  id              String  @id @default(uuid())
  assetSymbol     String
  categoryClass   String
  isCustomProfile Boolean @default(false)

  originalAmount   Decimal @db.Decimal(12, 2)
  originalCurrency String  @default("USD")
  baseAmountUSD    Decimal @db.Decimal(12, 2)

  quantity     Decimal  @db.Decimal(16, 8)
  strategyNote String
  workspaceId  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("investments")
}

/**
 * === SECTION 6 END ===
 */

/**
 * ==========================================================================
 * === SECTION 7: NOTIFICATIONS & VERIFICATION TOKENS ===
 * ==========================================================================
 */

model Notification {
  id     String @id @default(uuid())
  userId String

  title   String
  message String

  sourceType String
  sourceId   String?

  isRead    Boolean   @default(false)
  readAt    DateTime?
  emailSent Boolean   @default(false)

  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite index optimized for unread/recent user notifications
  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model VerificationToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique // Unique constraint creates a B-Tree index automatically
  type       TokenType // ENUM: Restricts token categories
  identifier String // E.g., target user email address
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  // WHY THIS FIX WAS MADE: Dedicated index on expiresAt allows background cron processes to clean up
  // expired verification tokens instantly without performing full sequential table scans.
  @@index([identifier])
  @@index([expiresAt])
  @@map("verification_tokens")
}

/**
 * === SECTION 7 END ===
 */

// prisma/schema.prisma

/**
 * ==========================================================================
 * === SECTION 1: GENERATOR & DATA SOURCE CONFIGURATION LAYOUT ===
 * ==========================================================================
 */
generator client {
  provider = "prisma-client-js" // Standard client library generation target engine
  output   = "./generated" // Compiles the TypeScript types into your custom subfolder target
}

datasource db {
  provider = "postgresql" // FIXED: Removed the `url` property completely to comply with Prisma 7 layout rules
}

/**
 * === SECTION 1 END ===
 */

/**
 * ==========================================================================
 * === SECTION 2: USER ACCOUNT CORE IDENTITY SCHEMA ===
 * ==========================================================================
 */
model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  uiTheme      String      @default("DARK")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workspaces   Workspace[]

  @@map("users")
}

/**
 * === SECTION 2 END ===
 */

/**
 * ==========================================================================
 * === SECTION 3: WORKSPACE MULTI-TENANCY ANCHOR CORE ===
 * ==========================================================================
 */
model Workspace {
  id           String        @id @default(uuid())
  name         String
  currency     String        @default("PKR")
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  investments  Investment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("workspaces")
}

/**
 * === SECTION 3 END ===
 */

/**
 * ==========================================================================
 * === SECTION 4: DYNAMIC TRANSACTION CATEGORIES SCHEMA ===
 * ==========================================================================
 */
model Category {
  id           String        @id @default(uuid())
  name         String
  type         String
  color        String
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("categories")
}

/**
 * === SECTION 4 END ===
 */

/**
 * ==========================================================================
 * === SECTION 5: HISTORICAL TRANSACTION LEDGER SCHEMA ===
 * ==========================================================================
 */
model Transaction {
  id          String    @id @default(uuid())
  amount      Decimal   @db.Decimal(12, 2)
  type        String
  description String
  date        DateTime
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("transactions")
}

/**
 * === SECTION 5 END ===
 */

/**
 * ==========================================================================
 * === SECTION 6: BUDGETING LIMIT & CAP MECHANICS ===
 * ==========================================================================
 */
model Budget {
  id          String    @id @default(uuid())
  limitAmount Decimal   @db.Decimal(12, 2)
  startDate   DateTime
  endDate     DateTime
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("budgets")
}

/**
 * === SECTION 6 END ===
 */

/**
 * ==========================================================================
 * === SECTION 7: SECURE INVESTMENT VAULT ASSET ENGINE ===
 * ==========================================================================
 */
model Investment {
  id              String    @id @default(uuid())
  assetSymbol     String
  categoryClass   String
  isCustomProfile Boolean   @default(false)
  totalInvested   Decimal   @db.Decimal(12, 2)
  capitalCurrency String    @default("GBP")
  quantity        Decimal   @db.Decimal(16, 8)
  strategyNote    String
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("investments")
}

/**
 * === SECTION 7 END ===
 */

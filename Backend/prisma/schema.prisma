// prisma/schema.prisma

/**
 * ==========================================================================
 * === SECTION 1: GENERATOR & DATA SOURCE CONFIGURATION LAYOUT ===
 * ==========================================================================
 */
generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

/**
 * === SECTION 1 END ===
 */

/**
 * ==========================================================================
 * === SECTION 2: USER ACCOUNT CORE IDENTITY SCHEMA ===
 * ==========================================================================
 */
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  vaultPin     String? // Secure 4-digit PIN hash
  uiTheme      String   @default("DARK")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 🚀 NEW: DYNAMIC ONBOARDING AND GLOBAL AI PERSONALIZATION FIELDS
  country       String? // e.g., "Pakistan", "United States", "Japan"
  currency      String? // Preferred base currency code, e.g., "PKR", "USD", "EUR"
  languages     String[] // Multi-select array of other spoken languages (e.g., ["Urdu", "Punjabi"])
  occupation    String? // Job type: e.g., "Salaried Employee", "Freelancer", "prefer_not_to_say"
  financialGoal String? // Vibe/Goal: e.g., "hustler", "saver", "tight_budgeter", "zen_master"
  aiPersona     String? // Buddy Voice: e.g., "savage_roaster", "supportive_coach", "forensic_detective"

  workspaces    Workspace[]
  // 👇 Added relation to the new Notification engine
  notifications Notification[]

  @@map("users")
}

/**
 * === SECTION 2 END ===
 */

/**
 * ==========================================================================
 * === SECTION 3: WORKSPACE MULTI-TENANCY ANCHOR CORE ===
 * ==========================================================================
 */
model Workspace {
  id           String        @id @default(uuid())
  name         String
  currency     String        @default("PKR") // Default viewing currency
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  investments  Investment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("workspaces")
}

/**
 * === SECTION 3 END ===
 */

/**
 * ==========================================================================
 * === SECTION 4: DYNAMIC TRANSACTION CATEGORIES SCHEMA ===
 * ==========================================================================
 */
model Category {
  id           String        @id @default(uuid())
  name         String
  type         String
  color        String
  isFixed      Boolean       @default(false)
  isRecurring  Boolean       @default(false)
  frequency    String?
  dueDay       Int?
  reminderDays Int?
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("categories")
}

/**
 * === SECTION 4 END ===
 */

/**
 * ==========================================================================
 * === SECTION 5: HISTORICAL TRANSACTION LEDGER SCHEMA ===
 * ==========================================================================
 */
model Transaction {
  id     String  @id @default(uuid())
  // DEPRECATED: Use originalAmount + originalCurrency + baseAmountUSD instead
  amount Decimal @db.Decimal(12, 2) // kept for compatibility; will be removed later

  // NEW ENTERPRISE FIELDS
  originalAmount   Decimal @db.Decimal(12, 2) // Amount as entered by user
  originalCurrency String  @default("USD") // Currency code of the original amount
  baseAmountUSD    Decimal @db.Decimal(12, 2) // Normalized USD value (for aggregations)

  type        String
  description String
  date        DateTime
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("transactions")
}

/**
 * === SECTION 5 END ===
 */

/**
 * ==========================================================================
 * === SECTION 6: BUDGETING LIMIT & CAP MECHANICS ===
 * ==========================================================================
 */
model Budget {
  id          String  @id @default(uuid())
  // DEPRECATED: limitAmount
  limitAmount Decimal @db.Decimal(12, 2) // kept for compatibility

  // NEW ENTERPRISE FIELDS
  originalAmount   Decimal @db.Decimal(12, 2)
  originalCurrency String  @default("USD")
  baseAmountUSD    Decimal @db.Decimal(12, 2)

  startDate   DateTime
  endDate     DateTime
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("budgets")
}

/**
 * === SECTION 6 END ===
 */

/**
 * ==========================================================================
 * === SECTION 7: SECURE INVESTMENT VAULT ASSET ENGINE ===
 * ==========================================================================
 */
model Investment {
  id              String  @id @default(uuid())
  assetSymbol     String
  categoryClass   String
  isCustomProfile Boolean @default(false)
  // DEPRECATED: totalInvested and capitalCurrency
  totalInvested   Decimal @db.Decimal(12, 2) // kept for compatibility
  capitalCurrency String  @default("GBP") // kept for compatibility

  // NEW ENTERPRISE FIELDS
  originalAmount   Decimal @db.Decimal(12, 2) // Total invested in original currency
  originalCurrency String  @default("USD")
  baseAmountUSD    Decimal @db.Decimal(12, 2) // Normalized USD value

  quantity     Decimal   @db.Decimal(16, 8)
  strategyNote String
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("investments")
}

/**
 * === SECTION 7 END ===
 */

/**
 * ==========================================================================
 * === SECTION 8: ENTERPRISE NOTIFICATION ENGINE ===
 * ==========================================================================
 */
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String // e.g., "Rent Bill Due"
  message String // e.g., "Your rent is due in 3 days."

  // 1. POLYMORPHIC TARGET LINKING
  sourceType String // e.g., "BILL_REMINDER", "BUDGET_ALERT", "SYSTEM"
  sourceId   String? // The string ID of the Category, Budget, etc.

  // 2. CHANNEL PREFERENCES & LIFECYCLE
  isRead    Boolean   @default(false)
  readAt    DateTime? // Enables soft-deleting from the UI
  emailSent Boolean   @default(false) // Ready for future email expansion

  // 3. IDEMPOTENCY KEY (ANTI-SPAM)
  idempotencyKey String @unique // e.g., "bill_reminder_cat123_07_2026"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexing createdAt makes the 30-day automated cleanup queries lightning fast
  @@index([createdAt])
  @@map("notifications")
}

/**
 * === SECTION 8 END ===
 */
